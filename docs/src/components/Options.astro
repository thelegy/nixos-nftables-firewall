---
import { Code } from 'astro:components';
import { marked } from 'marked';
import { getOptions, optionId, optionLabel } from '../lib/options';
import type { OptionValue } from '../lib/options';

interface Props { prefix: string }
const { prefix } = Astro.props;
const options = (await getOptions()).filter(({ name }) => name === prefix || name.startsWith(prefix + '.'));
if (!options.length) throw new Error(`No Nix options matched "${prefix}".`);
const markdown = (text: string) => marked.parse(
  text.replaceAll('<literal>', '`').replaceAll('</literal>', '`'),
  { async: false },
);
const valueText = (value: OptionValue) => value.text;
---

{options.map((option) => (
  <section class="nix-option">
    <div class="option-heading">
      <h3 id={optionId(option.name)}>{optionLabel(option.name, prefix)}</h3>
      <a class="option-permalink" href={`#${optionId(option.name)}`} aria-label={`Permalink to ${option.name}`}>#</a>
    </div>
    <table class="option-metadata">
      <caption class="sr-only">Metadata for {option.name}</caption>
      <colgroup><col class="option-label-column" /><col /></colgroup>
      <tbody>
        <tr>
          <th scope="row">Name</th>
          <td>
            <div class="option-path">
                  <code>{option.name}</code>
                  <button type="button" data-copy-option={option.name} aria-label={`Copy option path ${option.name}`} title="Copy path">
                    <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <rect x="8" y="8" width="12" height="12" rx="2" />
                      <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
                    </svg>
                    <svg class="copied-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="m5 12 4 4L19 6" />
                    </svg>
                    <span class="sr-only" role="status"></span>
                  </button>
                </div>
          </td>
        </tr>
        {option.description && <tr>
          <th scope="row">Description</th>
          <td><div set:html={markdown(option.description)} /></td>
        </tr>}
        <tr>
          <th scope="row">Type</th>
          <td>{option.type}</td>
        </tr>
        {(['default', 'example'] as const).map((field) => {
          const value = option[field];
          return value && <tr>
            <th scope="row">{field === 'default' ? 'Default' : 'Example'}</th>
            <td>
              {value._type === 'literalMD'
                ? <div set:html={markdown(valueText(value))} />
                : !value.text.includes('\n') && value.text.length <= 80
                  ? <code>{valueText(value)}</code>
                  : <Code code={valueText(value)} lang="nix" />}
            </td>
          </tr>;
        })}
        <tr>
          <th scope="row">Declared in</th>
          <td><ul class="option-sources">{option.declarations.map((path) => (
            <li><a href={`https://github.com/thelegy/nixos-nftables-firewall/blob/main/${path}`}>{path}</a></li>
          ))}</ul></td>
        </tr>
      </tbody>
    </table>
  </section>
))}


<script>
  document.addEventListener('click', async (event) => {
    const button = event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>('button[data-copy-option]')
      : null;
    if (!button) return;
    const label = button.querySelector('[role="status"]')!;
    try {
      await navigator.clipboard.writeText(button.dataset.copyOption!);
      label.textContent = 'Copied!';
      button.dataset.copyState = 'copied';
      button.title = 'Copied!';
    } catch {
      label.textContent = 'Copy failed';
      button.title = 'Copy failed';
    }
    setTimeout(() => {
      label.textContent = '';
      delete button.dataset.copyState;
      button.title = 'Copy path';
    }, 2000);
  });
</script>

<style>
  .nix-option {
    margin-block: 1.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .option-heading {
    display: flex;
    align-items: baseline;
    gap: .65rem;
  }
  .option-heading h3 {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .option-permalink {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 1rem;
  }
  .option-permalink:hover { color: var(--sl-color-text-accent); }
  .option-path {
    margin: 0;
    font-size: .8rem;
    line-height: inherit;
  }
  .option-path code {
    padding: 0;
    color: var(--sl-color-gray-2);
    background: none;
    font-size: .8rem;
    overflow-wrap: anywhere;
  }
  .option-path button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    vertical-align: -.25rem;
    width: 1.5rem;
    height: 1.25rem;
    margin: 0 0 0 .2rem;
    padding: 0;
    border: 0;
    border-radius: .35rem;
    background: transparent;
    color: var(--sl-color-text);
    font: inherit;
    font-size: .75rem;
    cursor: pointer;
  }
  /* Expand the hit area without making the table's line box taller. */
  .option-path button::after {
    content: '';
    position: absolute;
    inset: -.25rem 0;
  }
  .option-path button:hover { background: var(--sl-color-gray-6); }
  .copied-icon { display: none; }
  [data-copy-state="copied"] .copy-icon { display: none; }
  [data-copy-state="copied"] .copied-icon { display: block; }
  :is(.option-path button, .option-permalink):focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
</style>
