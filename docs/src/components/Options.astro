---
import InlineCode from './InlineCode.astro';
import CodeBlock from './CodeBlock.astro';
import { marked } from 'marked';
import { getOptions, optionId, optionLabel } from '../lib/options';
import type { OptionValue } from '../lib/options';

interface Props { prefix: string }
const { prefix } = Astro.props;
const options = (await getOptions()).filter(({ name }) => name === prefix || name.startsWith(prefix + '.'));
if (!options.length) throw new Error(`No Nix options matched "${prefix}".`);
const markdown = (text: string) => marked.parse(
  text.replaceAll('<literal>', '`').replaceAll('</literal>', '`'),
  { async: false },
);
const valueText = (value: OptionValue) => value.text;
---

{options.map((option) => (
  <section class="nix-option">
    <div class="option-heading">
      <h3 id={optionId(option.name)}>{optionLabel(option.name, prefix)}</h3>
      <a class="option-permalink" href={`#${optionId(option.name)}`} aria-label={`Permalink to ${option.name}`}>#</a>
    </div>
    <table class="option-metadata">
      <caption class="sr-only">Metadata for {option.name}</caption>
      <colgroup><col class="option-label-column" /><col /></colgroup>
      <tbody>
        <tr>
          <th scope="row">Name</th>
          <td>
            <InlineCode value={option.name} label="Copy option name" highlight={false} />
          </td>
        </tr>
        {option.description && <tr>
          <th scope="row">Description</th>
          <td><div set:html={markdown(option.description)} /></td>
        </tr>}
        <tr>
          <th scope="row">Type</th>
          <td>{option.type}</td>
        </tr>
        {(['default', 'example'] as const).map((field) => {
          const value = option[field];
          return value && <tr>
            <th scope="row">{field === 'default' ? 'Default' : 'Example'}</th>
            <td>
              {value._type === 'literalMD'
                ? <div set:html={markdown(valueText(value))} />
                : !value.text.includes('\n') && value.text.length <= 80
                  ? <InlineCode value={valueText(value)} label={field === 'default' ? 'Copy default value' : 'Copy example'} />
                  : <CodeBlock code={valueText(value)} />}
            </td>
          </tr>;
        })}
        <tr>
          <th scope="row">Declared in</th>
          <td><ul class="option-sources">{option.declarations.map((path) => (
            <li><a href={`https://github.com/thelegy/nixos-nftables-firewall/blob/main/${path}`}>
              {path}
              <svg class="source-link-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M15 3h6v6m0-6L10 14M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4" />
              </svg>
              <span class="sr-only"> (external link)</span>
            </a></li>
          ))}</ul></td>
        </tr>
      </tbody>
    </table>
  </section>
))}




<style>
  .nix-option {
    margin-block: 1.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .option-heading {
    display: flex;
    align-items: baseline;
    gap: .65rem;
  }
  .option-heading h3 {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .option-permalink {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 1rem;
  }
  .option-permalink:hover { color: var(--sl-color-text-accent); }
  .option-permalink:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
</style>
